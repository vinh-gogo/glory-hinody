## ============================================================
## Cloudflare Pages — HTTP Security Headers
## glory-hinody.pages.dev  |  glory-hinody
## ============================================================

/*
  # ── Content-Security-Policy (CSP) ─────────────────────────
  # Cho phép tối thiểu cần thiết, block tất cả còn lại
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://translate.google.com https://translate.googleapis.com https://www.gstatic.com https://giscus.app https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://translate.googleapis.com https://www.gstatic.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; frame-src https://giscus.app https://translate.google.com https://translate.googleapis.com; connect-src 'self' https://giscus.app https://translate.googleapis.com https://translate.google.com https://fonts.googleapis.com https://fonts.gstatic.com; media-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

  # ── Anti-Clickjacking ─────────────────────────────────────
  X-Frame-Options: DENY

  # ── MIME Sniffing Protection ───────────────────────────────
  X-Content-Type-Options: nosniff

  # ── XSS Filter (legacy browsers) ──────────────────────────
  X-XSS-Protection: 1; mode=block

  # ── Referrer Policy ───────────────────────────────────────
  Referrer-Policy: strict-origin-when-cross-origin

  # ── Permissions Policy (disable dangerous browser APIs) ───
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), fullscreen=(self), interest-cohort=()

  # ── HSTS: Force HTTPS 1 năm + preload ─────────────────────
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # ── Cross-Origin Policies ──────────────────────────────────
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: unsafe-none
  Cross-Origin-Resource-Policy: same-site

  # ── Cache-Control mặc định ────────────────────────────────
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# ── Static assets: cache dài hạn ──────────────────────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/js/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ── Images: cache 30 ngày ─────────────────────────────────
/posts/*/images/*
  Cache-Control: public, max-age=2592000, immutable
  X-Content-Type-Options: nosniff

# ── Sitemap & RSS: cache ngắn ─────────────────────────────
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/index.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/rss+xml; charset=utf-8

# ── Search index JSON ─────────────────────────────────────
/index.json
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
