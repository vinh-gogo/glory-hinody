\section{\Large{KINH NGHIỆM LÀM VIỆC}}

\textbf{\large{WETEC -- Công ty Cổ phần Công nghệ Năng lượng \& Môi trường Nước}} \hfill \textbf{10/2025 -- 12/2025} \\[2pt]
\textit{Thực tập sinh AI (AI Engineer Intern)} \\[2pt]
\large{\textbf{Mã nguồn: }\textit{\href{https://github.com/Vinh-Gogo/pdf-rag}{\small\faGithub\ \large{github.com/Vinh-Gogo/pdf-rag}}} \\[3pt]
