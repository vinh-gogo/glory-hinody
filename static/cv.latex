\section{TRÌNH ĐỘ HỌC VẤN}
\textbf{Trường Đại học Công nghiệp TP. Hồ Chí Minh (IUH)} \hfill \textbf{2021 -- 2025}\\
{\small Cử nhân Khoa học Máy tính \quad\textbar\quad \textbf{Khóa luận tốt nghiệp:} 4.0/4.0 (Xuất sắc) \hfill \textbf{Tiếng Anh:} Đọc hiểu tài liệu kỹ thuật chuyên sâu (B1 / CEFR)}

% --- KINH NGHIỆM LÀM VIỆC ---
\section{KINH NGHIỆM LÀM VIỆC}

\textbf{WETEC -- Công ty Cổ phần Công nghệ Năng lượng \& Môi trường Nước} \hfill TP. HCM\\
\textit{Thực tập sinh AI (AI Engineer Intern) \quad\textbar\quad \href{https://github.com/Vinh-Gogo/pdf-rag}{\faGithub\ github.com/Vinh-Gogo/pdf-rag}} \hfill \textbf{10/2025 -- 12/2025}
\begin{itemize}
  \item Xây dựng pipeline tự động thu thập và tiền xử lý tài liệu quy chuẩn kỹ thuật nước phức tạp (>200 trang) bằng Firecrawl AI.
  \item Thiết kế kiến trúc Semantic GraphRAG kết hợp Knowledge Graph (Neo4j) và Vector Search (Qdrant), rút ngắn thời gian truy xuất xuống <2s và loại bỏ hiện tượng trích dẫn sai số liệu/điều khoản so với RAG truyền thống.
  \item Đóng gói và triển khai REST API với FastAPI và Docker, phục vụ tra cứu quy chuẩn nội bộ phòng kỹ thuật.
  \item \textbf{Công nghệ cốt lõi:} GraphRAG (Neo4j, Qdrant), LangGraph, FastAPI, Docker.
\end{itemize}

% --- DỰ ÁN TIÊU BIỂU ---
\section{DỰ ÁN TIÊU BIỂU}

\textbf{Hệ Thống Multi-Agent CSKH \& Đặt Hàng Tự Động} \hfill Freelance | \textbf{06/2025 -- 10/2025}\\
\textit{Kỹ sư AI chính (Nhóm 3 thành viên) \quad\textbar\quad \href{https://youtu.be/R_IvnHsHmTw}{\faYoutube\ Video Demo} \quad\textbar\quad \href{https://glory-hinody.pages.dev/posts/multi-agent-workflow-langraph/}{\faGlobe\ Báo cáo kỹ thuật}}
\begin{itemize}
  \item Thiết kế kiến trúc Multi-Agent trên LangGraph tự động hóa quy trình CSKH: nhận diện ý định, tra cứu menu, đối soát tồn kho và xuất hóa đơn tự động cho đối tác chuỗi F\&B và bán lẻ.
  \item Xây dựng pipeline tìm kiếm lai (Hybrid Search: Semantic + BM25) với bộ tiền xử lý tiếng Việt chuyên sâu; đạt 95\% Hit@1 và 99\% Hit@5 trên tập 3.200 truy vấn kiểm thử do nhóm gán nhãn từ log hội thoại người dùng thực tế.
  \item Cấu hình phục vụ suy luận LLM song song qua vLLM trên GPU A100; chuẩn hóa giao thức công cụ bằng FastMCP (Model Context Protocol).
  \item \textbf{Công nghệ cốt lõi:} FastMCP, LangGraph, vLLM (Serving A100), Hybrid Search (Neo4j, BM25), FastAPI.
\end{itemize}

\vspace{2pt}
\textbf{Open Video Lab -- Pipeline Tạo Sinh Video AI Đa Phương Thức} \hfill Cá nhân | \textbf{2026}\\
\textit{Tác giả dự án \quad\textbar\quad \href{https://github.com/vinh-gogo/open-video-lab}{\faGithub\ github.com/vinh-gogo/open-video-lab} \quad\textbar\quad \href{https://glory-hinody.pages.dev/posts/openvideolab-video-diffusion/}{\faGlobe\ Báo cáo kỹ thuật}}
\begin{itemize}
  \item Xây dựng pipeline điều phối (orchestration) sinh video đa phương thức (Text/Image/Audio-to-Video) dựa trên các mô hình Diffusion Transformers (LTX-2.5, MiniMax, Wan).
  \item Triển khai kỹ thuật Multi-Subject Reference (MSR) can thiệp vào Cross-Attention nhằm duy trì tính nhất quán nhân vật qua nhiều cảnh nối tiếp.
  \item Tối ưu hóa suy luận với Quantization (int8/fp4), giảm mức VRAM từ 24GB xuống <14GB giúp chạy ổn định trên GPU 16GB (<60s/cảnh), tích hợp RIFE nội suy chuyển động 48/96fps.
  \item \textbf{Công nghệ cốt lõi:} PyTorch, Diffusion Transformers (DiT), Quantization (int8/fp4), TurboLoRA, RIFE.
\end{itemize}

\vspace{2pt}
\textbf{AI Lingua -- Nền Tảng Học Ngoại Ngữ Đa Nền Tảng} \hfill Cá nhân | \textbf{2026}\\
\textit{Tác giả dự án \quad\textbar\quad \href{https://github.com/Vinh-Gogo/ai-english}{\faGithub\ github.com/Vinh-Gogo/ai-english} \quad\textbar\quad \href{https://glory-hinody.pages.dev/posts/on-device-ai-onnx-kotlin/}{\faGlobe\ Báo cáo kỹ thuật}}
\begin{itemize}
  \item Phát triển ứng dụng đa nền tảng (Desktop \& Mobile) theo kiến trúc Kotlin Multiplatform (KMP), MVI và Clean Architecture, chia sẻ 85\% mã nguồn logic và giao diện Compose.
  \item Nhúng mạng nơ-ron On-Device AI qua ONNX Runtime để nhận diện nét viết chữ Hán/Kanji offline trực tiếp trên thiết bị, loại bỏ 100\% chi phí cloud API cho tính năng nhận diện này.
  \item Ứng dụng thuật toán lặp lại ngắt quãng FSRS tối ưu hóa đường cong ghi nhớ từ vựng (-23\% lượt ôn so với SM-2) và thiết kế cơ chế LLM Fallback Chain tự động chuyển đổi mô hình dự phòng khi quá tải hoặc đứt mạng.
  \item \textbf{Công nghệ cốt lõi:} On-Device AI (ONNX Runtime), Kotlin Multiplatform (KMP), Compose Multiplatform, Thuật toán FSRS.
\end{itemize}

% --- NGHIÊN CỨU KHOA HỌC ---
\section{NGHIÊN CỨU KHOA HỌC}
\textbf{Ước Lượng Độ Sâu Ảnh Đơn Dựa Trên Mạng Nơ-ron Tích Chập (CNN)} \hfill \textbf{SSRC 2024}\\
{\small \textit{Công bố tại Hội nghị Khoa học Sinh viên (SSRC 2024) \quad\textbar\quad \href{https://github.com/Vinh-Gogo/depth-estimation}{\faGithub\ github.com/Vinh-Gogo/depth-estimation}}
\begin{itemize}
  \item Đề xuất kiến trúc lai ghép ResNet-DenseNet kết hợp Skip-Connection cải tiến của U-Net trong bài toán Monocular Depth Estimation trên tập dữ liệu chuẩn NYU Depth v2.
  \item Đạt sai số RMSE 0.485 và tỷ lệ ngưỡng độ chính xác $\delta < 1.25$ đạt 86.2\% (cải thiện 12\% so với baseline U-Net tiêu chuẩn); tái tạo đám mây điểm 3D (Point Cloud) thời gian thực phục vụ thị giác máy tính.
\end{itemize}
}

% --- KỸ NĂNG CHUYÊN MÔN ---
\section{KỸ NĂNG CHUYÊN MÔN}
\begin{itemize}[leftmargin=*, noitemsep, topsep=1pt]
  \item \textbf{AI Agentic \& RAG:} Multi-Agent Workflows, FastMCP, LangGraph, GraphRAG (Neo4j, Qdrant), vLLM Serving, Prompt Engineering.
  \item \textbf{Generative AI \& Vision:} Diffusion Transformers (DiT), Multi-Subject Consistency, Quantization (int8/fp4), LoRA Fine-tuning, CNNs.
  \item \textbf{Kỹ thuật Phần mềm \& Nền tảng:} Kotlin Multiplatform (KMP), Compose Multiplatform, Clean Architecture, RESTful API, On-Device AI (ONNX).
  \item \textbf{Ngôn ngữ \& Công cụ:} Python, Kotlin, PyTorch, FastAPI, Docker, Git/GitHub, Linux, PostgreSQL, SQL.
\end{itemize}

